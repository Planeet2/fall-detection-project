# Folders
UPLOAD_DIR=uploads
LOG_DIR=logs
DETECTIONS_LOG_FILENAME=detections.json

# Models
YOLO_MODEL_NAME=yolov8n-pose.pt
LSTM_MODEL_PATH=fall_detection_lstm.pth

# ML parameters
SEQ_LEN=30
INPUT_SIZE=51
HIDDEN_SIZE=64
NUM_CLASSES=2
FALL_PROBABILITY_THRESHOLD=0.6
WARNING_PROBABILITY_THRESHOLD=0.4

# API
MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.webm
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
