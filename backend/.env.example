# Folders
UPLOAD_DIR=uploads
LOG_DIR=logs
DETECTIONS_LOG_FILENAME=detections.json
DATABASE_URL=postgresql://elderly_user:elderly_password@localhost:5433/elderly_check
# Optional alternative to DATABASE_URL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=elderly_check
POSTGRES_USER=elderly_user
POSTGRES_PASSWORD=elderly_password

# Models
YOLO_MODEL_NAME=yolov8n-pose.pt
LSTM_MODEL_PATH=fall_detection_lstm.pth

# ML parameters
SEQ_LEN=30
INPUT_SIZE=51
HIDDEN_SIZE=64
NUM_CLASSES=2
FALL_PROBABILITY_THRESHOLD=0.6
WARNING_PROBABILITY_THRESHOLD=0.4

# API
MAX_UPLOAD_MB=100
MAX_FRAME_UPLOAD_MB=5
ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.webm
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live camera tuning
YOLO_CONFIDENCE=0.25
POSE_KEYPOINT_CONFIDENCE=0.25
POSE_MIN_VISIBLE_KEYPOINTS=6
POSE_MIN_MEAN_CONFIDENCE=0.22
POSE_MIN_TORSO_CONFIDENCE=0.20
LIVE_SMOOTHING_WINDOW=8
LIVE_FALL_CONFIRM_FRAMES=4
LIVE_MISSING_RESET_FRAMES=8

YUANJING_API_KEY=
YUANJING_BASE_URL=https://maas-api.ai-yuanjing.com/openapi/compatible-mode/v1
YUANJING_MODEL=deepseek-v3
